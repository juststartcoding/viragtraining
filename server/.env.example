PORT=5000
# Production: listen only on localhost behind CyberPanel/OpenLiteSpeed (leave empty in development)
HOST=
# NODE_ENV=production
# Public site address used in sitemap.xml / canonical links (optional – detected from the request if empty)
SITE_URL=
MONGO_URI=mongodb://127.0.0.1:27017/virag_training
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins (dev)
CLIENT_URL=http://localhost:5173
# First admin account (created automatically on first start if no admin exists)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@viragtrainingsolutions.com
ADMIN_PASSWORD=Admin@12345
# Razorpay (optional). Without keys, paid orders go to "pending" for manual approval in Admin → Orders
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
